# Copy this file to .env and edit the values.

# MySQL connection: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
# The database is created automatically on first start if it does not exist.
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/calorai

# Any long random string. Used to sign login tokens.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Full path to tesseract.exe (leave blank if Tesseract is on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Trained food-recognition model (produced by ml/train_food_model.py)
MODEL_PATH=../ml/models/food_model.keras
LABELS_PATH=../ml/models/labels.txt
